# ─────────────────────────────────────────────────────────────────────────────
# Lexikon — environment variable reference
# Copy this file to .env and fill in the values before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# Local Compose only: used by both the `db` service and the app URL.
# Replace with a strong URL-safe value (letters, digits, hyphens, underscores).
POSTGRES_PASSWORD=changeme

# External DB Compose only: uncomment and set to a PostgreSQL connection string.
# Percent-encode special characters in the username/password. Use TLS for remote
# databases (for RDS, append ?sslmode=require).
# DATABASE_URL=postgres://dbuser:password@your-db-host:5432/memexkb?sslmode=require

# ── Security ──────────────────────────────────────────────────────────────────

# Random secret used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production — the server will refuse to start without it.
SESSION_SECRET=replace-with-a-long-random-string

# ── Cookie / session ──────────────────────────────────────────────────────────

# Set to "true" ONLY when serving over HTTPS (e.g. behind a TLS-terminating
# reverse proxy). Browsers silently drop Secure cookies over http://localhost,
# so leave this "false" or unset for plain HTTP / Docker Desktop port-mapping.
COOKIE_SECURE=false

# SameSite attribute for the session cookie: "lax" (default) | "strict" | "none".
# Use "none" only with HTTPS — it automatically enables the Secure flag.
# COOKIE_SAMESITE=lax

# Number of trusted reverse-proxy hops for IP / protocol detection.
# Set to 0 when running without any reverse proxy (direct port-mapping).
# Local Compose defaults to 0; external Compose defaults to 0.
# Set to 1 behind a single trusted proxy such as an AWS ALB.
# TRUST_PROXY=1

# ── Network ───────────────────────────────────────────────────────────────────

# Host port that docker compose maps to the container's port 3000.
PORT=3000

# Optional: comma-separated list of allowed CORS origins.
# Leave unset to disallow all cross-origin requests (same-origin only).
# CORS_ORIGIN=https://wiki.example.com

# ── Seeding (first-boot only) ─────────────────────────────────────────────────

# Set to "true" to create the initial admin account on startup.
# The account is only created if it does not already exist.
# Remove or set to "false" after the first successful boot.
# RUN_SEED=true
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=changeme123
