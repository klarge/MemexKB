{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true, "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["web/src/*"],
      "@workspace/db": ["db/index.ts"],
      "@workspace/api-zod": ["shared/zod/index.ts"],
      "@workspace/api-client-react": ["shared/client/index.ts"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["server", "db", "shared", "web/src", "scripts", "test", "*.ts"]
}
